# AccessHire AI - Environment Configuration Template
PROJECT_NAME="AccessHire AI Backend"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# MongoDB Database Settings
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="accesshire_db"

# Authentication & Security
JWT_SECRET="change-this-to-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / AI Orchestrator Settings
LLM_PROVIDER="gemini" # Options: gemini, openai, groq, ollama
LLM_MODEL="gemini-1.5-flash"
LLM_API_KEY="your-llm-api-key-here"

# File Upload Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
